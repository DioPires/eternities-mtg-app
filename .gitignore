# Node
node_modules/
web/dist/
*.tsbuildinfo

# Playwright output (PRD 8.9.2's route smoke). The report and the traces are per-run diagnostics;
# CI uploads them as an artefact instead.
web/playwright-report/
web/test-results/
web/blob-report/

# Windows measurement kit output (review §9). Regenerated on every run and sent back as a folder,
# not committed. `git add -f` if a particular run's results should be kept in the repo.
web/bench/windows/results/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Pipeline working files. Artefacts under web/public/data/ ARE committed (PRD 8.1.4) so a clone
# deploys without running the pipeline; the Scryfall bulk cache is not.
pipeline/.cache/
pipeline/scryfall-cache/

# Local
.DS_Store
.vercel/
.env
.env.local
