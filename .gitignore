# Node
node_modules/
web/dist/
*.tsbuildinfo

# Playwright output (PRD 8.9.2's route smoke). The report and the traces are per-run diagnostics;
# CI uploads them as an artefact instead.
web/playwright-report/
web/test-results/
web/blob-report/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Coverage is measured on every pytest run (pipeline/pyproject.toml), so this file is rewritten
# constantly. Committing it makes a clean tree dirty the moment anyone runs the suite.
.coverage
.coverage.*

# Pipeline working files. Artefacts under web/public/data/ ARE committed (PRD 8.1.4) so a clone
# deploys without running the pipeline; the Scryfall bulk cache is not.
pipeline/.cache/
pipeline/scryfall-cache/

# Local
.DS_Store
.vercel/
.env
.env.local
